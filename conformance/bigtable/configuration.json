    {
      "id": "bigtable-seeded-configuration-match",
      "rules": [
        "BT-16"
      ],
      "description": "両テーブルに記録した設定がクライアントの設定と一致すれば、生成が成功し、追記と読み取りができる。",
      "backends": [
        "bigtable"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          }
        },
        "snapshots": {
          "s1": {
            "aggregate": {
              "total": 1
            },
            "seq_nr": 1,
            "manifest": ""
          }
        }
      },
      "seed": {
        "configuration": {
          "journal": {
            "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
            "layout_version": 1,
            "keep_snapshot_count": 1,
            "retention_mode": "delete",
            "envelope_limit_bytes": 1048576
          },
          "head": {
            "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
            "layout_version": 1,
            "keep_snapshot_count": 1,
            "retention_mode": "delete",
            "envelope_limit_bytes": 1048576
          }
        }
      },
      "steps": [
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e1",
            "snapshot": "s1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 1,
            "snapshot": "s1"
          }
        }
      ],
      "initialization": {
        "expect": {
          "result": "success"
        }
      }
    },
