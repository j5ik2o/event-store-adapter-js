      "seed": {
        "configuration": {
          "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
          "layout_version": 1,
          "keep_snapshot_count": 1,
          "retention_mode": "ttl",
          "ttl_grace_days": 7,
          "change_feed_enabled": false
        },
        "row_deletion_policy_days": 7
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        }
      ],
      "initialization": {
        "expect": {
