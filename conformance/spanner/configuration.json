    {
      "id": "spanner-change-feed-unsupported",
      "rules": [
        "SPN-17"
      ],
      "description": "Spannerの保存先は最初の版で変更フィードを提供しないので、それを求める設定では生成が設定エラーとなる。",
      "backends": [
        "spanner"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete",
        "change_feed": true
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
