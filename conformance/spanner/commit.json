{
  "format": "scenarios",
  "version": "1.3.0",
  "cases": [
    {
      "id": "spanner-aborted-retry-within-limit",
      "rules": [
        "SPN-7"
      ],
      "description": "コミットが中断（ABORTED）されても、やり直しの上限（3）以内（2回）なら追記が成功し、同じ封筒が採番し直されずに1件だけ読める。",
      "backends": [
        "spanner"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete",
        "transaction_retry_limit": 3
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 2
            },
            "manifest": ""
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1",
              "e2"
            ]
          }
        }
      ],
      "faults": [
        {
          "operation": 2,
          "phase": "commit",
          "kind": "transaction-aborted",
          "details": {
            "message": "STORAGE_SENTINEL"
          },
          "repeat": {
            "mode": "count",
            "count": 2
          },
          "injection": "replace-request"
        }
      ]
    },
    {
      "id": "spanner-aborted-retry-limit-exceeded",
      "rules": [
        "SPN-7"
      ],
      "description": "コミットの中断がやり直しの上限（2）を超える（3回）と保存先エラーとなり、何も確定しない。同じ追記を送り直すと成功する。",
      "backends": [
        "spanner"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete",
        "transaction_retry_limit": 2
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 2
            },
            "manifest": ""
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "expect": {
            "error": {
              "category": "storage",
              "message": {
                "must_contain": [],
                "must_not_contain": []
              }
            }
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1"
            ]
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1",
              "e2"
            ]
          }
        }
      ],
      "faults": [
        {
          "operation": 2,
          "phase": "commit",
          "kind": "transaction-aborted",
          "details": {
            "message": "STORAGE_SENTINEL"
          },
          "repeat": {
            "mode": "count",
            "count": 3
          },
          "injection": "replace-request"
        }
      ]
    },
    {
      "id": "spanner-commit-response-lost",
      "rules": [
        "SPN-8",
        "W-7"
      ],
      "description": "コミットの応答を失うと成否不明の保存先エラーとなる。同じ封筒を送り直すと確定済みなので楽観ロックとなり、読み取りではそのイベントが1件だけ返る。",
      "backends": [
        "spanner"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "error": {
              "category": "storage",
              "message": {
                "must_contain": [],
                "must_not_contain": []
              }
            }
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "error": {
              "category": "optimistic-lock",
              "message": {
                "must_contain": [
                  "Order-9",
                  "1"
                ],
                "must_not_contain": []
              }
            }
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1"
            ]
          }
        }
      ],
      "faults": [
        {
          "operation": 1,
          "phase": "commit",
          "kind": "storage-error",
          "details": {
            "message": "STORAGE_SENTINEL"
          },
          "repeat": {
            "mode": "count",
            "count": 1
          },
          "injection": "replace-response"
        }
      ]
    }
  ]
}
