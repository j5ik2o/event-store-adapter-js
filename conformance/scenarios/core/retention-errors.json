    {
      "id": "core-retention-zero",
      "rules": [
        "S-1",
        "E-1"
      ],
      "description": "保持件数0では生成が設定エラーとなる。",
      "backends": [
        "memory",
        "dynamodb"
      ],
      "store": {
        "retention_count": 0,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
    {
      "id": "core-retention-delete-1",
      "rules": [
        "S-1",
        "S-2"
      ],
      "description": "現在のスナップショットとは別に、新しい保持件数分の履歴だけを残す。履歴読み取りの応答計画を差し込み、GSIの反映待ちによる差を除く。",
      "backends": [
        "memory",
        "dynamodb"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
