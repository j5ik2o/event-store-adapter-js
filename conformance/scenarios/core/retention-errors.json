        },
        "snapshots": {
          "s1": {
            "aggregate": {
              "total": 1
            },
            "seq_nr": 1,
            "manifest": ""
          },
          "s2": {
            "aggregate": {
              "total": 2
            },
            "seq_nr": 2,
            "manifest": ""
          },
          "s3": {
            "aggregate": {
              "total": 3
            },
            "seq_nr": 3,
            "manifest": ""
          },
          "s4": {
            "aggregate": {
              "total": 4
            },
            "seq_nr": 4,
            "manifest": ""
          }
        }
      },
      "steps": [
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e1",
            "snapshot": "s1"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                1
              ],
              "marked": [],
              "absent": []
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e2",
            "snapshot": "s2"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                2
              ],
              "marked": [],
              "absent": [
                1
              ]
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e3",
            "snapshot": "s3"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                3
              ],
              "marked": [],
              "absent": [
                1,
                2
              ]
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e4",
            "snapshot": "s4"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                4
              ],
              "marked": [],
              "absent": [
                1,
                2,
                3
              ]
            }
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 4,
            "snapshot": "s4"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1",
              "e2",
              "e3",
              "e4"
            ]
          }
        }
      ],
      "faults": [
        {
          "operation": 1,
          "phase": "retention-query",
          "kind": "sdk-response",
          "details": {
            "history_pages": [
              [
                1
              ]
            ]
          },
          "repeat": {
            "mode": "count",
            "count": 1
          },
          "injection": "replace-response"
        },
        {
          "operation": 2,
          "phase": "retention-query",
          "kind": "sdk-response",
          "details": {
            "history_pages": [
              [
                2,
                1
              ]
            ]
          },
          "repeat": {
            "mode": "count",
            "count": 1
          },
          "injection": "replace-response"
        },
        {
          "operation": 3,
          "phase": "retention-query",
          "kind": "sdk-response",
          "details": {
            "history_pages": [
              [
                3,
                2
              ]
            ]
          },
          "repeat": {
            "mode": "count",
            "count": 1
          },
          "injection": "replace-response"
        },
        {
          "operation": 4,
          "phase": "retention-query",
          "kind": "sdk-response",
          "details": {
            "history_pages": [
              [
                4,
                3
              ]
            ]
          },
          "repeat": {
            "mode": "count",
            "count": 1
          },
          "injection": "replace-response"
        }
      ]
    },
