{
  "format": "scenarios",
  "version": "1.3.0",
  "cases": [
    {
      "id": "sqlite-write-lock-busy",
      "rules": [
        "SQ-7",
        "E-1"
      ],
      "description": "別の接続が同じファイルの書き込みのロックを持つ間、追記は待ち時間の超過で楽観ロックではなく保存先エラーになり、何も確定しない。ロックを放した後は同じ追記が成功し、読み直せる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete",
        "lock_wait_milliseconds": 100
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 2
            },
            "manifest": ""
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "holdWriteLock",
          "arguments": {},
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "expect": {
            "error": {
              "category": "storage",
              "message": {
                "must_contain": [],
                "must_not_contain": []
              }
            }
          }
        },
        {
          "op": "releaseWriteLock",
          "arguments": {},
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1",
              "e2"
            ]
          }
        }
      ]
    }
  ]
}
