          "keep_snapshot_count": null,
          "retention_mode": "delete",
          "change_feed_enabled": 0
        }
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
