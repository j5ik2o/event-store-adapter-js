            }
          }
        }
      }
    },
    {
      "id": "sqlite-seeded-change-feed-enabled",
      "rules": [
        "SQ-20"
      ],
      "description": "保存先に記録した change_feed_enabled が 1 のストアを開く生成は、設定エラーとなる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "seed": {
        "configuration": {
          "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
          "layout_version": 1,
          "keep_snapshot_count": null,
          "retention_mode": "delete",
          "change_feed_enabled": 1
        }
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
    {
      "id": "sqlite-seeded-configuration-match",
      "rules": [
        "SQ-2",
        "SQ-19"
      ],
      "description": "保存先に記録した設定がクライアントの設定と一致すれば、生成が成功し、追記と読み取りができる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          }
        },
        "snapshots": {
          "s1": {
            "aggregate": {
              "total": 1
            },
            "seq_nr": 1,
            "manifest": ""
          }
        }
      },
      "seed": {
        "configuration": {
          "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
          "layout_version": 1,
          "keep_snapshot_count": 1,
          "retention_mode": "delete",
          "change_feed_enabled": 0
        }
      },
      "steps": [
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e1",
            "snapshot": "s1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 1,
            "snapshot": "s1"
          }
        }
      ],
      "initialization": {
        "expect": {
          "result": "success"
        }
      }
    }
  ]
}
