{
  "format": "scenarios",
  "version": "1.3.0",
  "cases": [
    {
      "id": "sqlite-ttl-unsupported",
      "rules": [
        "SQ-11"
      ],
      "description": "SQLiteの保存先は期限切れ方式を提供しないので、それを求める設定では生成が設定エラーとなる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "ttl",
        "ttl_grace_seconds": 60
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
    {
      "id": "sqlite-change-feed-unsupported",
      "rules": [
        "SQ-20"
      ],
      "description": "SQLiteの保存先は最初の版で変更フィードを提供しないので、それを求める設定では生成が設定エラーとなる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete",
        "change_feed": true
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
    {
      "id": "sqlite-seeded-keep-count-mismatch",
      "rules": [
        "SQ-2",
        "SQ-19"
      ],
      "description": "保存先に記録した保持件数（2）とクライアントの保持件数（1）が異なると、生成が設定エラーとなる。",
      "backends": [
        "sqlite"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "seed": {
        "configuration": {
          "store_id": "5f0c8b8e-3c1a-4d7e-9a4b-2f6d1c0e7a11",
          "layout_version": 1,
          "keep_snapshot_count": 2,
          "retention_mode": "delete",
          "change_feed_enabled": 0
        }
      },
      "steps": [],
      "initialization": {
        "expect": {
          "error": {
            "category": "configuration",
            "message": {
              "must_contain": [],
              "must_not_contain": []
            }
          }
        }
      }
    },
    {
      "id": "sqlite-seeded-layout-version-mismatch",
      "rules": [
        "SQ-2"
      ],
