            }
          },
          {
            "table": "snapshot",
            "attributes": {
              "aid": "S",
              "skey": "N",
              "seq_nr": "N",
              "manifest": "S",
              "payload": "B",
              "last_updated_at": "N",
              "active_history_seq_nr": "N"
            },
            "values": {
              "aid": "Customer-5",
              "skey": "2",
              "seq_nr": "2",
              "manifest": "",
              "last_updated_at": "123",
              "active_history_seq_nr": "2"
