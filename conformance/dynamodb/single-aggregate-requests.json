{
  "format": "scenarios",
  "version": "1.1.0",
  "cases": [
    {
      "id": "dynamodb-single-aggregate-delete",
      "rules": [
        "DY-19"
      ],
      "description": "削除方式の保持でも、書き込み・読み取り・保持処理は操作の集約の aid に絞った 6 種類の API だけで行い、別の集約の記録を読み書きしない。",
      "backends": [
        "dynamodb"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 2
            },
            "manifest": ""
          },
          "e3": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 3,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 3
            },
            "manifest": ""
          }
