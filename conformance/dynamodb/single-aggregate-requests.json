        "snapshots": {
          "s2": {
            "aggregate": {
              "total": 2
            },
            "seq_nr": 2,
            "manifest": ""
          },
          "s3": {
            "aggregate": {
              "total": 3
            },
            "seq_nr": 3,
            "manifest": ""
          }
        }
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "request_scope": {
              "apis": [
                "GetItem",
                "BatchGetItem",
                "Query",
                "TransactWriteItems",
                "BatchWriteItem",
                "UpdateItem"
              ],
              "aid": "aggregate_id"
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e2",
            "snapshot": "s2"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "request_scope": {
              "apis": [
                "GetItem",
                "BatchGetItem",
                "Query",
                "TransactWriteItems",
                "BatchWriteItem",
                "UpdateItem"
              ],
              "aid": "aggregate_id"
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e3",
            "snapshot": "s3"
          },
          "expect": {
            "result": "success"
          },
          "observe": {
            "request_scope": {
              "apis": [
                "GetItem",
                "BatchGetItem",
                "Query",
                "TransactWriteItems",
                "BatchWriteItem",
                "UpdateItem"
              ],
              "aid": "aggregate_id"
            },
            "history": {
              "active": [
                3
              ],
              "marked": [],
              "absent": [
                2
              ]
            }
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 3,
            "snapshot": "s3"
