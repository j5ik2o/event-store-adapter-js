{
  "format": "scenarios",
  "version": "1.0.0",
  "cases": [
    {
      "id": "dynamodb-config-new",
      "rules": [
        "DY-8",
        "D-1",
        "E-1"
      ],
      "description": "3テーブルの設定がすべて未作成なら、共通のstore_idと版1を条件付きトランザクションで作成する。",
      "backends": [
        "dynamodb"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {},
        "snapshots": {}
      },
      "steps": [],
      "seed": {
        "items": []
      },
      "initialization": {
        "expect": {
          "result": "success"
        },
        "observe": {
          "requests": [
            {
              "api": "BatchGetItem",
              "phase": "configuration-read",
              "constraints": {
                "keys": [
                  "journal:__config__:0",
                  "snapshot:__config__:0",
                  "head:__config__"
                ],
                "consistent_read_all_tables": true
              }
            },
            {
              "api": "TransactWriteItems",
              "phase": "configuration-create",
              "constraints": {
                "put_tables": [
                  "journal",
                  "snapshot",
                  "head"
                ],
                "condition": {
                  "attribute_not_exists": "aid"
                },
                "same_store_id": true,
                "layout_version": 1
              }
            }
          ],
          "items": [
            {
              "table": "journal",
              "attributes": {
                "aid": "S",
                "store_id": "S",
                "layout_version": "N",
                "seq_nr": "N"
              },
              "values": {
                "aid": "__config__",
                "layout_version": "1",
                "seq_nr": "0"
              },
              "bindings": {
                "store_id": "generated-store-id"
              }
            },
            {
              "table": "snapshot",
              "attributes": {
                "aid": "S",
                "store_id": "S",
                "layout_version": "N",
                "skey": "N"
              },
              "values": {
                "aid": "__config__",
                "layout_version": "1",
                "skey": "0"
              },
              "bindings": {
                "store_id": "generated-store-id"
              }
            },
            {
              "table": "head",
              "attributes": {
                "aid": "S",
                "store_id": "S",
                "layout_version": "N"
              },
              "values": {
                "aid": "__config__",
                "layout_version": "1"
              },
              "bindings": {
                "store_id": "generated-store-id"
              }
            }
          ]
        }
      }
    },
