{
  "format": "scenarios",
  "version": "1.3.0",
  "cases": [
    {
      "id": "memory-store-new-independent",
      "rules": [
        "MEM-2"
      ],
      "description": "新しい保存先として生成した2つ目のストアは空で、1つ目のストアと独立している。1つ目に書いた記録は2つ目から読めず、2つ目に書いても1つ目の結果は変わらない。",
      "backends": [
        "memory"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "source": "primary"
            }
          },
          "f1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "source": "second"
            }
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "createStore",
          "arguments": {
            "name": "second",
            "storage": "new"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "store": "second",
          "expect": {
            "result": "none"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "store": "second",
          "expect": {
            "result": "events",
            "events": []
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "f1"
          },
          "store": "second",
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1"
            ]
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 1,
            "snapshot": null
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "store": "second",
          "expect": {
            "result": "events",
            "events": [
              "f1"
            ]
          }
        }
      ]
    },
    {
      "id": "memory-store-shared",
      "rules": [
        "MEM-2"
      ],
      "description": "1つ目の保存先を明示的に共有して生成した2つ目のストアは、全記録・ヘッド・排他制御を共有する。一方で書いた記録は他方から読め、同じ seq_nr の書き込みは楽観ロックで失敗する。",
      "backends": [
        "memory"
      ],
      "store": {
        "retention_count": null,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "source": "primary"
            }
          },
          "e1-other": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "source": "second"
            }
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "source": "second"
            }
          }
        },
        "snapshots": {}
      },
      "steps": [
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "createStore",
          "arguments": {
            "name": "second",
            "storage": "shared",
            "shared_with": "primary"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "store": "second",
          "expect": {
            "result": "events",
            "events": [
              "e1"
            ]
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "store": "second",
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 1,
            "snapshot": null
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e1-other"
          },
          "store": "second",
          "expect": {
            "error": {
              "category": "optimistic-lock",
              "message": {
                "must_contain": [
                  "Order-9",
                  "1"
                ],
                "must_not_contain": [
                  "CREDENTIAL_SENTINEL",
                  "https://storage.invalid/private",
                  "SDK_RAW_SENTINEL"
                ]
              }
            }
          }
        },
        {
          "op": "persistEvent",
          "arguments": {
            "event": "e2"
          },
          "store": "second",
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "getEventsByIdSinceSeqNr",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1
          },
          "expect": {
            "result": "events",
            "events": [
              "e1",
              "e2"
            ]
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 2,
            "snapshot": null
          }
        }
      ]
    },
    {
      "id": "memory-store-shared-configuration",
      "rules": [
        "MEM-2"
      ],
      "description": "共有して生成した2つ目のストアは、記録と排他制御だけでなく設定（履歴の保持件数）も共有する。保持件数1の1つ目のストアと共有した2つ目のストアからスナップショット付きの追記を重ねても、履歴は最新の1件だけが残る。",
      "backends": [
        "memory"
      ],
      "store": {
        "retention_count": 1,
        "retention_mode": "delete"
      },
      "fixtures": {
        "events": {
          "e1": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 1,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 1
            },
            "manifest": ""
          },
          "e2": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 2,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 2
            },
            "manifest": ""
          },
          "e3": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            },
            "seq_nr": 3,
            "occurred_at": "2026-10-05T00:00:00.123456789Z",
            "payload": {
              "number": 3
            },
            "manifest": ""
          }
        },
        "snapshots": {
          "s1": {
            "aggregate": {
              "total": 1
            },
            "seq_nr": 1,
            "manifest": ""
          },
          "s2": {
            "aggregate": {
              "total": 2
            },
            "seq_nr": 2,
            "manifest": ""
          },
          "s3": {
            "aggregate": {
              "total": 3
            },
            "seq_nr": 3,
            "manifest": ""
          }
        }
      },
      "steps": [
        {
          "op": "createStore",
          "arguments": {
            "name": "second",
            "storage": "shared",
            "shared_with": "primary"
          },
          "expect": {
            "result": "success"
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e1",
            "snapshot": "s1"
          },
          "store": "second",
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                1
              ],
              "marked": [],
              "absent": []
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e2",
            "snapshot": "s2"
          },
          "store": "second",
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                2
              ],
              "marked": [],
              "absent": [
                1
              ]
            }
          }
        },
        {
          "op": "persistEventAndSnapshot",
          "arguments": {
            "event": "e3",
            "snapshot": "s3"
          },
          "store": "second",
          "expect": {
            "result": "success"
          },
          "observe": {
            "history": {
              "active": [
                3
              ],
              "marked": [],
              "absent": [
                1,
                2
              ]
            }
          }
        },
        {
          "op": "getLatestSnapshotById",
          "arguments": {
            "aggregate_id": {
              "type_name": "Order",
              "value": "9"
            }
          },
          "expect": {
            "result": "snapshot",
            "head_seq_nr": 3,
            "snapshot": "s3"
          }
        }
      ]
    }
  ]
}
