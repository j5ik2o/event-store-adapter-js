{
  "name": "event-store-adapter-js",
  "version": "3.0.2-snapshot.6",
  "description": "This library is designed to turn DynamoDB into an Event Store for Event Sourcing.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc && node ./scripts/remove-test-artifacts.mjs",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --no-cache",
    "coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --no-cache --coverage",
    "lint": "biome check src/",
    "fmt": "biome format src/",
    "fix": "biome check --write src/",
    "clean": "rimraf ./dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j5ik2o/event-store-adapter-js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ddd",
    "cqrs",
    "event-sourcing",
    "dynamodb"
  ],
  "author": "Junichi Kato <j5ik2o@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.0.0",
    "rimraf": "6.1.3",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.413.0",
    "@google-cloud/spanner": "^8.7.1",
    "aws-sdk": "^2.1459.0",
    "moment": "^2.29.4",
    "ulid": "^3.0.0",
    "winston": "^3.10.0"
  }
}
