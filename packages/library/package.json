{
  "name": "event-store-adapter-js",
  "version": "5.3.0",
  "description": "This library is designed to turn DynamoDB into an Event Store for Event Sourcing.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./spanner": {
      "import": {
        "types": "./dist/esm/spanner.d.mts",
        "default": "./dist/esm/spanner.mjs"
      },
      "require": {
        "types": "./dist/spanner.d.ts",
        "default": "./dist/spanner.js"
      },
      "default": "./dist/spanner.js"
    },
    "./sqlite": {
      "import": {
        "types": "./dist/esm/sqlite.d.mts",
        "default": "./dist/esm/sqlite.mjs"
      },
      "require": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "default": "./dist/sqlite.js"
    },
    "./bigtable": {
      "import": {
        "types": "./dist/esm/bigtable.d.mts",
        "default": "./dist/esm/bigtable.mjs"
      },
      "require": {
        "types": "./dist/bigtable.d.ts",
        "default": "./dist/bigtable.js"
      },
      "default": "./dist/bigtable.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc && node ./scripts/remove-test-artifacts.mjs && node ./scripts/build-esm.mjs",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --no-cache",
    "coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --no-cache --coverage",
    "lint": "biome check src/",
    "fmt": "biome format src/",
    "fix": "biome check --write src/",
    "clean": "rimraf ./dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j5ik2o/event-store-adapter-js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ddd",
    "cqrs",
    "event-sourcing",
    "dynamodb"
  ],
  "author": "Junichi Kato <j5ik2o@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@google-cloud/bigtable": "^7.5.0",
    "@google-cloud/spanner": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "8.20.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "jest": "^30.0.0",
    "rimraf": "6.1.4",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.413.0",
    "protobufjs": "7.6.6"
  },
  "peerDependencies": {
    "@google-cloud/spanner": "^8.7.1 || ^9.0.0",
    "@google-cloud/bigtable": "^7.5.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/spanner": {
      "optional": true
    },
    "@google-cloud/bigtable": {
      "optional": true
    }
  }
}
