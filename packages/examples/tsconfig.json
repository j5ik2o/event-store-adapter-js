{
  "compilerOptions": {
    "strict": true,
    "module": "CommonJS",
    "target": "es2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "event-store-adapter-js": ["../library/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
